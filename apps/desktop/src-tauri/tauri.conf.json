{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCG Engine",
  "version": "0.1.0",
  "identifier": "dev.ccg.engine",
  "build": {
    "beforeDevCommand": "pnpm --filter @ccg/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ccg/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CCG Engine",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Make and play tactical card games",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"] },
      "rpm": { "depends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
