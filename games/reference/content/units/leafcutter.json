{
  "formatVersion": 1,
  "kind": "unit",
  "id": "leafcutter",
  "name": "Leafcutter",
  "art": "assets/units/leafcutter.svg",
  "behavior": {
    "kind": "if",
    "cond": {
      "kind": "enemyWithin",
      "range": 1
    },
    "else": {
      "kind": "if",
      "cond": {
        "kind": "enemyWithin",
        "range": 2
      },
      "else": {
        "kind": "intent",
        "intent": {
          "name": "March",
          "effects": [
            {
              "op": "approach",
              "distance": 2
            }
          ],
          "target": {
            "kind": "unit",
            "select": "nearestEnemy"
          }
        }
      },
      "then": {
        "kind": "intent",
        "intent": {
          "name": "Spit",
          "effects": [
            {
              "op": "damage",
              "amount": 4
            }
          ],
          "target": {
            "kind": "unit",
            "range": 2,
            "select": "nearestEnemy"
          }
        }
      }
    },
    "then": {
      "kind": "intent",
      "intent": {
        "name": "Bite",
        "effects": [
          {
            "op": "damage",
            "amount": 6
          }
        ],
        "target": {
          "kind": "unit",
          "range": 1,
          "select": "nearestEnemy"
        }
      }
    }
  },
  "hp": 9
}
