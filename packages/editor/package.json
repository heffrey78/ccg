{
  "name": "@ccg/editor",
  "version": "0.0.0",
  "description": "The ccg game editor: project model, undo/redo, storage adapters, validation and the editor UI.",
  "type": "module",
  "exports": {
    ".": {
      "@ccg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "@ccg/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ccg/client": "workspace:^",
    "@ccg/content": "workspace:^",
    "@ccg/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
