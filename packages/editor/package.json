{
  "name": "@ccg/editor",
  "version": "0.0.0",
  "description": "The ccg game editor: project model, undo/redo, storage adapters and validation.",
  "type": "module",
  "exports": {
    ".": {
      "@ccg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ccg/content": "workspace:^",
    "@ccg/core": "workspace:^",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
