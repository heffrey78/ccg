{
  "name": "@ccg/core",
  "version": "0.0.0",
  "description": "Deterministic, headless rules engine for turn-based tactical card games.",
  "type": "module",
  "exports": {
    ".": {
      "@ccg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^10.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
