{
  "name": "@ccg/content",
  "version": "0.0.0",
  "description": "Editable content format for ccg games: schemas, validation, load/save and migrations.",
  "type": "module",
  "exports": {
    ".": {
      "@ccg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
