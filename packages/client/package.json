{
  "name": "@ccg/client",
  "version": "0.0.0",
  "description": "Platform-agnostic React UI and engine host for ccg games.",
  "type": "module",
  "exports": {
    ".": {
      "@ccg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "@ccg/source": "./src/engine/index.ts",
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ccg/content": "workspace:^",
    "@ccg/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
